# ── Auth0 OIDC App (Human Login) ─────────────────────────────────────────────
# Your Auth0 tenant domain, e.g. dev-abc123.us.auth0.com
AUTH0_DOMAIN=

# Regular web app credentials (Authorization Code + PKCE)
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Random 32-char secret used to encrypt the session cookie
# Generate with: openssl rand -hex 32
AUTH0_SECRET=

# The API audience (identifier of the API you created in Auth0)
AUTH0_AUDIENCE=

# Base URL of the app — http://localhost:3000 locally, your Vercel URL in prod
APP_BASE_URL=http://localhost:3000

# ── Auth0 M2M App — Agent Reader ─────────────────────────────────────────────
# Machine-to-machine app with data:read scope only
AUTH0_READER_CLIENT_ID=
AUTH0_READER_CLIENT_SECRET=

# ── Auth0 M2M App — Agent Writer ─────────────────────────────────────────────
# Machine-to-machine app with data:read + data:write scopes
AUTH0_WRITER_CLIENT_ID=
AUTH0_WRITER_CLIENT_SECRET=

# ── Auth0 Management API ──────────────────────────────────────────────────────
# M2M app with read:logs permission on the Auth0 Management API
AUTH0_MGMT_CLIENT_ID=
AUTH0_MGMT_CLIENT_SECRET=
